FoamFile
{
    format      ascii;
    class       volScalarField;
    object      kl;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    airfoil
    {
        type            fixedValue;
        value           uniform 0;
    }
    inlet
    {
        type            freestream;
        freestreamValue uniform 0;
    }
    outlet
    {
        type            freestream;
        freestreamValue uniform 0;
    }
    topandbottom
    {
        type            freestream;
        freestreamValue uniform 0;
    }
    frontandback
    {
        type            empty;
    }
}