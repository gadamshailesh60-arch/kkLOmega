FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG; // PCG;
        //preconditioner  DIC;
        tolerance       1e-06;
        relTol          0.05;
        smoother        symGaussSeidel; // GaussSeidel; 
    }

    pFinal
    {
        $p;
        tolerance       1e-07;
        relTol          0;
    }

    // CRITICAL FIX: Removed e and h, added kl
    "(U|kt|kl|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0.1;
    }

    "(U|kt|kl|omega)Final"
    {
        $U;
        tolerance       1e-08;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor yes; 
    nOuterCorrectors  2;
    nCorrectors       2;
    nNonOrthogonalCorrectors 1; 
    pRefCell          0;
    pRefValue         0;
}

relaxationFactors
{
    equations
    {
        ".*"        0.5; 
    }
}

